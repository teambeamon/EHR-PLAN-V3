# Turso Database Configuration
# Create your database at https://turso.tech/ with name: ehr-plan-db
# Then get your auth token from Settings > Auth Tokens
NEXT_PUBLIC_TURSO_URL=libsql://ehr-plan-db.turso.io
NEXT_PUBLIC_TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Admin password (default: admin123)
# Change this if you want a different password
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

# ============================================
# Vercel Environment Variables (REQUIRED for deployment)
# Set these in your Vercel project at:
# https://vercel.com/dashboard -> Project -> Settings -> Environment Variables
# ============================================
# TURSO_URL=libsql://ehr-plan-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token-here
