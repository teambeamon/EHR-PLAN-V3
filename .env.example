# Turso Database Configuration
NEXT_PUBLIC_TURSO_URL=libsql://your-db-name.turso.io
NEXT_PUBLIC_TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin password (change this!)
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

